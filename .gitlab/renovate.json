{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        ":automergeDisabled",
        "config:recommended",
        "group:allNonMajor"
    ],
    "dockerfile": {
        "enabled": false
    },
    "baseBranchPatterns": ["master", "gh-pages"],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^\\.gitlab-ci\\.yml$/"],
            "matchStrings": ["VMSHED_VERSION: (?<currentValue>v[\\d.]+)"],
            "depNameTemplate": "LINBIT/vmshed",
            "datasourceTemplate": "github-releases"
        }
    ]
}
